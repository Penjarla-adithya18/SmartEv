# Local environment example — copy to .env.local and set real values
# Set to '1' to use frontend mock mode (no backend required)
NEXT_PUBLIC_USE_MOCKS=1

# Backend base URL (spring boot / API gateway)
NEXT_PUBLIC_API_URL=http://localhost:8080

# AI service (FastAPI) base URL
NEXT_PUBLIC_AI_URL=http://localhost:8000

# WebSocket URL for real-time charger updates
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Google Maps API key (public client-side key)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_KEY_HERE

# Supabase backend credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Admin Portal Configuration
NEXT_PUBLIC_ADMIN_SECRET_PATH=/admin
NEXT_PUBLIC_ADMIN_SECRET_KEY=5566

# Twilio SMS Service Credentials (Example Placeholders)
DISABLE_TWILIO_SMS=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
TWILIO_PHONE_NUMBER=+15551234567

# AI LLM API Keys (Ollama / Gemini / OpenAI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
NEXT_PUBLIC_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
